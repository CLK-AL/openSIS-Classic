@startuml data-model
!theme plain
title openSIS Classic - Core Data Model (Simplified)

skinparam linetype ortho

entity "staff" as staff {
  * staff_id : INT <<PK>>
  --
  current_school_id : INT <<FK>>
  first_name : VARCHAR
  last_name : VARCHAR
  profile : ENUM(admin,teacher)
  profile_id : INT
  email : VARCHAR
  is_disable : CHAR(1)
}

entity "students" as students {
  * student_id : INT <<PK>>
  --
  first_name : VARCHAR
  last_name : VARCHAR
  middle_name : VARCHAR
  gender : VARCHAR
  ethnicity : VARCHAR
  birthdate : DATE
  username : VARCHAR
}

entity "school_years" as sy {
  * marking_period_id : INT <<PK>>
  --
  syear : INT
  school_id : INT <<FK>>
  title : VARCHAR
  start_date : DATE
  end_date : DATE
}

entity "schools" as schools {
  * id : INT <<PK>>
  --
  title : VARCHAR
  address : VARCHAR
  city : VARCHAR
  state : VARCHAR
  principal : VARCHAR
}

entity "courses" as courses {
  * course_id : INT <<PK>>
  --
  syear : INT
  school_id : INT <<FK>>
  subject_id : INT <<FK>>
  title : VARCHAR
  grade_level : INT
}

entity "course_periods" as cp {
  * course_period_id : INT <<PK>>
  --
  course_id : INT <<FK>>
  teacher_id : INT <<FK>>
  room : VARCHAR
  total_seats : INT
  marking_period_id : INT <<FK>>
}

entity "schedule" as sched {
  * student_id : INT <<FK>>
  * course_period_id : INT <<FK>>
  --
  start_date : DATE
  end_date : DATE
  marking_period_id : INT <<FK>>
}

entity "attendance_period" as attp {
  * student_id : INT <<FK>>
  * course_period_id : INT <<FK>>
  * school_date : DATE
  --
  attendance_code : INT
  remarks : TEXT
}

entity "gradebook_grades" as gbg {
  * student_id : INT <<FK>>
  * assignment_id : INT <<FK>>
  --
  points : DECIMAL
  comment : TEXT
}

entity "gradebook_assignments" as gba {
  * assignment_id : INT <<PK>>
  --
  course_period_id : INT <<FK>>
  assignment_type_id : INT
  title : VARCHAR
  assigned_date : DATE
  due_date : DATE
  points : DECIMAL
}

entity "report_card_grades" as rcg {
  * id : INT <<PK>>
  --
  syear : INT
  school_id : INT <<FK>>
  grade_scale_id : INT
  title : VARCHAR
  break_off : DECIMAL
}

entity "student_enrollment" as enroll {
  * id : INT <<PK>>
  --
  student_id : INT <<FK>>
  syear : INT
  school_id : INT <<FK>>
  grade_id : INT
  start_date : DATE
  end_date : DATE
  enrollment_code : INT
  drop_code : INT
}

entity "i18n" as i18n {
  * translation_key : VARCHAR
  * lang : VARCHAR(10)
  --
  translation : TEXT
  last_updated : TIMESTAMP
  updated_by : INT
}

entity "library_books" as books {
  * book_id : INT <<PK>>
  --
  school_id : INT <<FK>>
  title : VARCHAR
  author : VARCHAR
  isbn : VARCHAR
  category_id : INT
  total_copies : INT
  available_copies : INT
}

entity "library_checkout" as libco {
  * id : INT <<PK>>
  --
  book_id : INT <<FK>>
  borrower_type : VARCHAR
  borrower_id : INT
  checkout_date : DATE
  due_date : DATE
  return_date : DATE
  status : VARCHAR
}

entity "inventory_equipment" as equip {
  * equipment_id : INT <<PK>>
  --
  school_id : INT <<FK>>
  name : VARCHAR
  serial_number : VARCHAR
  condition_status : VARCHAR
  purchase_cost : DECIMAL
  total_quantity : INT
  available_quantity : INT
}

entity "inventory_field_trips" as trips {
  * id : INT <<PK>>
  --
  school_id : INT <<FK>>
  title : VARCHAR
  destination : VARCHAR
  trip_date : DATE
  cost_per_student : DECIMAL
  total_budget : DECIMAL
  status : VARCHAR
}

entity "inventory_finance" as fin {
  * id : INT <<PK>>
  --
  school_id : INT <<FK>>
  category : VARCHAR
  title : VARCHAR
  student_id : INT <<FK>>
  amount : DECIMAL
  payment_type : VARCHAR
  status : VARCHAR
}

entity "inventory_birthdays" as bday {
  * id : INT <<PK>>
  --
  school_id : INT <<FK>>
  student_id : INT <<FK>>
  event_date : DATE
  gift_budget : DECIMAL
  collected_amount : DECIMAL
  status : VARCHAR
}

entity "inventory_donations" as don {
  * id : INT <<PK>>
  --
  school_id : INT <<FK>>
  donation_type : VARCHAR
  donor_name : VARCHAR
  monetary_value : DECIMAL
  beneficiary_student_id : INT <<FK>>
  beneficiary_tag : VARCHAR
  status : VARCHAR
}

entity "inventory_student_needs" as needs {
  * id : INT <<PK>>
  --
  school_id : INT <<FK>>
  student_id : INT <<FK>>
  need_type : VARCHAR
  priority : VARCHAR
  estimated_cost : DECIMAL
  funded_amount : DECIMAL
  funded_by_donation_id : INT <<FK>>
  status : VARCHAR
}

schools ||--|{ sy : contains
schools ||--|{ courses : offers
courses ||--|{ cp : has periods
cp }|--|| staff : taught by
cp ||--|{ sched : enrolls
students ||--|{ sched : scheduled in
students ||--|{ enroll : enrolled at
students ||--|{ attp : tracked
cp ||--|{ attp : attendance for
cp ||--|{ gba : assignments
gba ||--|{ gbg : grades
students ||--|{ gbg : receives
books ||--|{ libco : checked out
students ||--|{ libco : borrows
students ||--|{ fin : pays
students ||--|{ bday : celebrates
schools ||--|{ trips : organizes
schools ||--|{ equip : owns
schools ||--|{ don : receives
don }o--o| students : benefits
students ||--|{ needs : has needs
don ||--o{ needs : funds

@enduml
